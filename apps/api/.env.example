NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://localhost:27017/scheduler

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
TOKEN_ENCRYPTION_KEY=

WEB_ORIGIN=http://localhost:5173
WEB_BASE_URL=http://localhost:5173
APP_BASE_URL=http://localhost:4000
COOKIE_SECURE=false

# Leave unset to log emails to the console instead of sending.
RESEND_API_KEY=
EMAIL_FROM="Scheduler <noreply@scheduler.local>"

# Google Calendar / Meet (Phase 7) — leave unset until you create a Google Cloud OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google/callback

# Optional: bootstrap an admin account on first boot if the DB is empty.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=
