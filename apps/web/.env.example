# Leave unset for local dev (Vite proxies /api to the backend).
# In production, set this to your deployed backend's origin, e.g. https://scheduler-api.onrender.com
VITE_API_URL=

# Google OAuth 2.0 Client ID (Web application) for "Sign in with Google".
# Client IDs are not secret — safe to ship in the frontend bundle. Leave unset to hide the button.
# Must match GOOGLE_CLIENT_ID in apps/api/.env.
VITE_GOOGLE_CLIENT_ID=
